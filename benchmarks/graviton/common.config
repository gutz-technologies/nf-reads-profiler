includeConfig "${projectDir}/conf/aws_batch.config"
params {
    input = "${projectDir}/benchmarks/graviton/samples.csv"
    enable_humann = true
    enable_medi = false
    enable_strainphlan = false
    skipCompleted = false
    // Require the original sample to be deep enough for the largest cap.
    minreads = 10000000
}
workDir = "s3://gutz-nf-reads-profilers-workdir/benchmarks/${params.project}"
process {
    withName: 'clean_reads' {
        // fastp --dedup exceeded 4 GiB, including the smallest tier.
        // Historical accuracy-3 peak RSS <4.28 GiB; cap retries at 16 GiB.
        memory = { task.attempt == 1 ? 8.GB : 16.GB }
        ext.reads_to_process = {
            def caps = ['100k': 100000, '300k': 300000, '1m': 1000000,
                        '3m': 3000000, '10m': 10000000]
            def cap = caps[meta.id.tokenize('_').last()]
            if (cap == null) throw new IllegalArgumentException("Unknown benchmark tier: ${meta.id}")
            cap
        }
    }
    // Do not silently ignore missing benchmark results after retries.
    errorStrategy = { task.attempt <= task.maxRetries ? 'retry' : 'terminate' }
    withName: 'profile_function' {
        errorStrategy = { task.attempt <= task.maxRetries ? 'retry' : 'terminate' }
    }
}
trace {
    fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,cpus,memory,queue,workdir'
}
