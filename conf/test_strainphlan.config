// Extends test profile to exercise StrainPhlAn (SAM output from profile_taxa).
// Run: nextflow run main.nf -profile test_strainphlan -resume
//
// What this tests:
//   1. profile_taxa emits MetaPhlAn SAM (-s <id>.sam.bz2) when enable_strainphlan=true
//   2. (later) SAM -> sample2markers -> clade detection -> strainphlan trees
//
// StrainPhlAn branches at the direct_metaphlan step, so HUMAnN and MEDI are off:
// the pipeline is count_reads -> clean_reads -> profile_taxa(SAM) -> combine_metaphlan.
//
// Uses the real vJan25 DB (toy DB is too small to share clades across samples).
// vJan25 is staged at /home/ubuntu/disk_dbs/metaphlan_databases/vJan25/ (ssddbs is
// wiped on reboot; disk_dbs is the persistent stage). Docker must bind disk_dbs.
// Default workDir is ./work — reuses the existing cache from prior max005 runs, so
// SRA download + read cleaning cache-hit and only profile_taxa reruns.

includeConfig 'test.config'

executor {
    queueSize = 10
}
process {
    withName: 'profile_taxa' {
        cpus   = 8
        memory = 38.GB
    }
    // These run inside the STRAINPHLAN subworkflow, so the selector must match the
    // qualified name (STRAINPHLAN:sample2markers, ...). A bare 'sample2markers'
    // pattern does NOT match the qualified name, so test.config's catch-all
    // withName:'.*' { memory = 8.GB } wins instead — and 8 GB OOM-kills the DB load
    // (exit 137), since Docker translates the memory directive into --memory.
    // cpus live on the processes (single-threaded); only memory is tuned here, from
    // scrape_traces.sh.
    withName: 'STRAINPHLAN:sample2markers' {
        memory = 16.GB   // measured peak_rss 12.6 GB
    }
    withName: 'STRAINPHLAN:print_clades|STRAINPHLAN:strainphlan|STRAINPHLAN:extract_markers' {
        memory = 32.GB   // print_clades peaked 25.7 GB at 6 samples; scales with sample count
    }
}

// Bind the persistent DB stage into Docker (base config only binds /mnt/scratch/ssddbs).
docker.runOptions = "--user \$(id -u):\$(id -g) -v /home/ubuntu/disk_dbs:/home/ubuntu/disk_dbs"

params {
    outdir             = "$projectDir/test-out"
    project            = 'strainphlan-test'
    input              = "$projectDir/assets/samplesheet-strainphlan.csv"
    nreads             = 0      // full profiling (override test.config nreads)
    minreads           = 1000   // HMP strainphlan tutorial samples are tiny (12k-85k reads); drop below 1k
    skipCompleted      = false  // no prior strainphlan outputs; force profile_taxa to run

    enable_strainphlan = true
    // Detected clades to build strain trees for (steps 3-4). t__SGB1877 is in the
    // HMP run (6 samples), t__SGB4584 in the SRP662258 run (4 samples). Combos where
    // a clade isn't in a run are skipped (strainphlan process errorStrategy 'ignore').
    strainphlan_clades = 't__SGB1877,t__SGB4584'
    skipHumann         = true   // StrainPhlAn branches at direct_metaphlan; HUMAnN not needed
    enable_medi        = false

    // MetaPhlAn DB — real vJan25 from the persistent stage
    direct_metaphlan_id = "mpa_vJan25_CHOCOPhlAnSGB_202503"
    direct_metaphlan_db = "/home/ubuntu/disk_dbs/metaphlan_databases/vJan25/"
}

// Re-enable reports (test.config disables them)
report.enabled = true
trace.enabled  = true

// Keep work dir so we can inspect SAM files and sizes after the run
cleanup = false
