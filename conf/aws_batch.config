workDir = 's3://gutz-nf-reads-profilers-workdir/work'   // S3 workdir for Batch jobs. MEDI processes now route to the spot-medi queue (workers stage the Kraken DB to instance-store NVMe at boot), not executor='local' on the head node.
cleanup = false

params {
    // ECR mirrors — override public images from nextflow.config for AWS workers
    docker_container_humann4   = '730883236839.dkr.ecr.us-east-2.amazonaws.com/humann:4.0.3'
    docker_container_metaphlan = '730883236839.dkr.ecr.us-east-2.amazonaws.com/metaphlan:4.2.4'
    docker_container_multiqc   = '730883236839.dkr.ecr.us-east-2.amazonaws.com/multiqc:v1.22.3'
    docker_container_fastp     = '730883236839.dkr.ecr.us-east-2.amazonaws.com/fastp:1.1.0'
    docker_container_aws       = '730883236839.dkr.ecr.us-east-2.amazonaws.com/aws-cli-bash:2'
    docker_container_sra       = '730883236839.dkr.ecr.us-east-2.amazonaws.com/sra-tools-bash:3.0.7'
    docker_container_medi      = '730883236839.dkr.ecr.us-east-2.amazonaws.com/medi:0.2.1'

    input    = "s3://gutz-nf-reads-profilers-runs/samplesheets/samplesheet-test-sra.csv"
    outdir   = "s3://gutz-nf-reads-profilers-runs/results"   // NO trailing slash!

    // Re-stamp ts here (it's also in nextflow.config) so it is non-null when THIS
    // file's report/trace blocks interpolate. The `-c` config tree is parsed in
    // isolation before nextflow.config's params merge, so without this the blocks
    // freeze ${params.ts} -> null (-> null_report.html). project must likewise be
    // set BEFORE includeConfig of this file in the run config (see header note below).
    ts = new java.util.Date().format('yyyyMMdd_HHmmss')

    // DBs synced from S3 to /mnt/dbs/ at boot per queue (thin AMI; see infra/multiqueue-design.md)
    // MetaPhlAn
    direct_metaphlan_id = "mpa_vJan25_CHOCOPhlAnSGB_202503"
    direct_metaphlan_db = "/mnt/dbs/metaphlan_databases/vJan25/"
    direct_bt2options   = "very-sensitive"
    // HUMAnN4
    humann_metaphlan_id = "mpa_vOct22_CHOCOPhlAnSGB_202403"
    humann_metaphlan_db = "/mnt/dbs/metaphlan_databases/vOct22/"
    humann_bt2options   = "very-sensitive"
    humann_chocophlan   = "/mnt/dbs/chocophlan_v4_alpha/"
    humann_uniref       = "/mnt/dbs/uniref90_annotated_v4_alpha_ec_filtered/"
    humann_utilitymap   = "/mnt/dbs/full_mapping_v4_alpha/"
    humann_extraparams  = "" // Like --bypass-translated-search

    // MEDI DB — staged to instance-store NVMe at /mnt/dbs/medi_db/ on each
    // spot-medi worker (MediWorkerLaunchTemplate), bind-mounted via volumes below.
    enable_medi        = true
    medi_db_path       = '/mnt/dbs/medi_db/'
    medi_food_matches  = '/mnt/dbs/medi_db/food_matches.csv'
    medi_food_contents = '/mnt/dbs/medi_db/food_contents.csv.gz'
}

// from https://github.com/nextflow-io/nextflow/issues/1371#issuecomment-587958867
executor {
    submitRateLimit = '10/s'
    // Maximum tasks Nextflow keeps in flight across all states (SUBMITTED
    // + RUNNABLE + RUNNING). Acts as a global flow-control cap independent
    // of CE MaxvCpus. Raise toward 1000+ for the >1k sample runs.
    queueSize = 500
    // autoThrottle = true
    // poolSize = 8
    // maxPoolSize = 8
    // Nextflow-side retries for Batch API. Disabled here, avoid double-retry layers.
    // maxRetries = 0
    // keepAlive = '1 min'
    // errorBurstDelay = '1 sec'
    // backOffMinRate = 0
    // backOffFactor = 2
    // rampUpInterval = 100
    // rampUpFactor = 1.2
}
process {
    executor = 'awsbatch'
    cache = 'lenient'

    // Default: spot instances for most processes
    queue = 'spot-queue'
    cpus = 2
    memory = 4.GB
    time = 1.h
    // Retry transient failures (spot reclaim, OOM, Docker timeout), then ignore
    // so one sample failure doesn't abort the whole run.
    maxRetries    = 3
    errorStrategy = { task.attempt <= task.maxRetries ? 'retry' : 'ignore' }

    // Global resource caps - prevents runaway memory on retries
    resourceLimits = [
        cpus: 24,
        memory: 384.GB,  // ceiling = one full 384 GB metaphlan node. sample2markers fills it:
                         // ~15 GB/worker (dmesg OOM, real) x 22 workers = 330 GB. Request 352 GB
                         // (not 384 — ECS reserves agent/OS RAM, so a 384 GB box advertises <384
                         // and a 384.GB request never schedules). 22 < 24 / 352 < 384 pass clean.
        time: 6.h
    ]

    // On-node start gate: when a fresh spot node joins, Batch dispatches several
    // queued jobs onto it at once and they all warm their DB into page cache
    // simultaneously — an I/O+RAM thundering herd. flock on the host-shared
    // /mnt/dbs bind-mount (aws.batch.volumes, below) serialises job starts on each
    // node: each job grabs the lock, sleeps 10 s, releases — so starts on a given
    // node land ~10 s apart. The lock file is host-local, so it self-scopes per
    // node (metaphlan and humann run on separate nodes). `|| true` so a missing
    // flock/path degrades to no-gate rather than failing the job.
    withName: 'profile_taxa' {
        queue  = 'spot-metaphlan'
        time   = 1.h
        memory = 36.GB // peak rss under 36 for vJan25 db
        cpus   = 16 // x2 internally
        beforeScript = 'flock /mnt/dbs/.nf_start_gate.lock -c "sleep 10" || true'
    }

    withName: 'profile_function' {
        queue  = 'spot-humann'
        time   = 4.h
        memory = { task.attempt == 1 ? 25.GB : 40.GB } // peak rss 24.9 GB. Need more data
        cpus   = 16 // x2 internally
        maxRetries    = 1
        errorStrategy = { task.attempt <= task.maxRetries ? 'retry' : 'ignore' }
        beforeScript = 'flock /mnt/dbs/.nf_start_gate.lock -c "sleep 10" || true'
    }

    // combine_humann_tables joins per-sample HUMAnN TSVs across a whole run
    // (genefamilies is ~1000-wide). The default 4.GB static block OOM-killed it
    // (exit 137) on cosmosid-infant 3month+1year (2026-06-23) — and the default
    // block doesn't scale memory by attempt, so all 3 retries died identically.
    // Scale up per attempt, staying under the 94.GB resourceLimits cap.
    // Routed to spot-humann (2026-08-17, gemma under8g run): spot-queue's CE tops
    // out at m8g/c8g.4xlarge (~64GB usable), so attempt 2 (64.GB) and attempt 3
    // (90.GB) requests were never schedulable there — MISCONFIGURATION:
    // JOB_RESOURCE_REQUIREMENT. spot-humann's metal instances fit these easily,
    // and this job reads the same per-study HUMAnN output that queue just made.
    withName: 'combine_humann_tables' {
        queue  = 'spot-humann'
        cpus   = 4
        memory = { task.attempt == 1 ? 32.GB : (task.attempt == 2 ? 64.GB : 90.GB) }
        maxRetries    = 2
        errorStrategy = { task.attempt <= task.maxRetries ? 'retry' : 'ignore' }
    }

    // Same oversized-for-spot-queue issue as combine_humann_tables above — scales
    // to 180.GB, past what spot-queue's CE can ever schedule.
    withName: 'convert_tables_to_biom' {
        queue  = 'spot-humann'
        cpus   = 4
        memory = { task.attempt == 1 ? 32.GB : (task.attempt == 2 ? 90.GB : 180.GB) }
        maxRetries    = 2
        errorStrategy = { task.attempt <= task.maxRetries ? 'retry' : 'ignore' }
    }

    // GEMMA stage 1 (preprocess_gemma.nf) — lane merge / depth cap. The `cat`
    // path is a pure S3->S3 byte copy and finishes inside the 1 h default, but
    // the `proportional` path decompresses the WHOLE lane to take an evenly
    // spread sample (bin/gemma_take_pairs.py --total). Measured ~1 M records/s
    // for the sampler on top of gzip inflate, so GMA_353 (392M pairs, R1+R2,
    // 111.6 GB gz) is a ~2 h task and the 1 h default would kill it. Only 12
    // samples take that path; the other 1344 still finish in minutes.
    withName: 'GEMMA_MERGE_LANES' {
        cpus   = 4
        memory = 4.GB
        time   = { 4.h * task.attempt }
    }

    // StrainPhlAn also runs on spot-metaphlan — same vJan25 DB as profile_taxa.
    withName: 'STRAINPHLAN:sample2markers' {
        queue  = 'spot-metaphlan'
        // cpus is interpolated into the script (`--nprocs ${task.cpus}`), so changing
        // it busts the sample2markers cache. cpus=22 matches the live cache — verified
        // 2026-06-25 by reading the cached task .command.sh (work/11/5f7e9d), which
        // ran `--nprocs 22`. Keep it 22 so a -resume cache-hits all markers
        // MaxvCPUsMetaphlan=200 lets two 96-vCPU boxes run two tasks.
        // TODO: new quque with 16gb/cpu like x8g.8xlarge x8g.12xlarge r8g.metal-24xl
        // cpus = 32 memory = 500.GB, or cpus = 16 memory 250.GB, and smaller chunks
        cpus   = 16
        memory = 250.GB
        time   = 2.h
        // terminate (not ignore) on final failure — print_clades is a per-run reduce
        // that would get nothing if these markers silently vanished.
        maxRetries    = 2
        errorStrategy = { task.attempt <= task.maxRetries ? 'retry' : 'terminate' }
    }
    // print_clades loads every sample's markers at once
    withName: 'STRAINPHLAN:print_clades' {
        queue  = 'spot-metaphlan'
        memory = 32.GB  // peak rss was 25.7 GB
        time   = 10.m
    }
    withName: 'STRAINPHLAN:extract_markers|STRAINPHLAN:strainphlan' {
        queue  = 'spot-metaphlan'
        memory = 8.GB   // peak rss 6.4 GB
        time   = 30.m
    }

    // MEDI: all processes route to the spot-medi queue. Its workers stage the
    // Kraken DB to instance-store NVMe and warm the 414 GiB hash into RAM at boot
    // (MediWorkerLaunchTemplate), so kraken reads it from /mnt/dbs/medi_db/. This
    // replaces the old executor='local' (head-node) path — the big RAM box is now
    // a spot node sized exactly for the hash, not a pinned on-demand head node.
    // Note: glob 'MEDI_QUANT:*' does not match qualified names in this NF version;
    // processes are listed explicitly.
    withName: 'MEDI_QUANT:kraken_report|MEDI_QUANT:count_taxa' {
        queue = 'spot-medi'
    }
    withName: 'MEDI_QUANT:architeuthis_filter' {
        queue = 'spot-medi'
        // Writes a multi-GB _filtered.k2. Run in a scratch dir on the
        // instance-store NVMe RAID (/mnt/dbs, bind-mounted rw, multi-GB/s)
        scratch = '/mnt/dbs'
    }
    withName: 'MEDI_QUANT:merge_taxonomy|MEDI_QUANT:add_lineage|MEDI_QUANT:quantify|MEDI_QUANT:summarize_mappings|MEDI_QUANT:merge_mappings' {
        queue = 'spot-medi'
    }
    withName: 'MEDI_QUANT:quantify' {
        // Per-run reduce: quantify.R loads every lineage-annotated counts table
        // (D+G+S) for the whole study at once, so its memory scales with cohort
        // size, not per-sample. The 4 GB process default OOM-killed it (exit
        // 137) on all 4 attempts of the gemma under8g run (1252 samples,
        // 133.1 MB of D+G+S input).
        // Sizing from every successful quantify trace to date (gemma-smoke
        // 0.51 MB input, cosmosid-infant 3month 29.5 MB, 1year 59.7 MB):
        // peak_vmem 8.1-10.1 GB in ALL of them, i.e. already >4 GB even on the
        // smallest. peak_rss reads a flat ~0.68 GB across that 120x input range
        // and is not trustworthy — the task only runs ~20 s, shorter than the
        // trace sampler resolves. under8g's input is 2.2x the largest success,
        // so 10.1 GB x 2.2 ~= 22 GB -> 24 GB, doubling on retry. The task is
        // under a minute, so the reservation costs effectively nothing.
        memory = { task.attempt == 1 ? 24.GB : 48.GB }
    }
    withName: 'MEDI_QUANT:convert_medi_to_biom|MEDI_QUANT:multiqc' {
        queue = 'spot-medi'
    }
    withName: 'MEDI_QUANT:kraken' {
        queue         = 'spot-medi'
        cpus          = 8
        time          = 10.m
        errorStrategy = { task.attempt < 2 ? 'retry' : 'ignore' }
        maxRetries    = 1
        // OOM-killed on 4 samples across the gemma under8g/over8g stage-2 runs
        // (GMA_383_neb_01, GMA_383_v_neb_01, GMA_448_neb_01, sGMA_749; ~0.3% of
        // ~1350 invocations), all "Container killed due to memory usage" with
        // no trace metrics captured (killed before Nextflow's first poll).
        // The trace's peak_rss/peak_vmem is NOT usable evidence here, unlike
        // quantify: every *successful* kraken run reads ~411-415 GB, which is
        // the shared, boot-warmed 414 GB hash mmap'd with --memory-mapping
        // (host page cache, not this process's private allocation) — it reads
        // the same regardless of sample size. This is an empirical bump
        // pending real evidence, not a trace-derived number: double the
        // process default (4 GB), matching the existing 2-attempt retry.
        memory = { task.attempt == 1 ? 8.GB : 16.GB }
        // Hash is warmed into page cache at instance boot (cat hash.k2d in the
        // launch-template UserData), so the first job on each worker finds it in
        // RAM (~100 GB/s) — no per-job vmtouch needed.
        //
        // The --output .k2 is one line per read (multi-GB).
        // Run in a scratch dir on the instance-store NVMe RAID (/mnt/dbs,
        // bind-mounted rw via aws.batch.volumes, multi-GB/s) instead.
        // Overrides the `scratch false` in the process body (config wins).
        scratch       = '/mnt/dbs'
    }

}
aws {
    client {
        // Use S3 Intelligent-Tiering for work directory (auto-optimizes cost)
        uploadStorageClass = 'INTELLIGENT_TIERING'
        // AWS SDK retry budget for *S3 client* calls (GetObject, PutObject,
        // ListBucket). Covers transient 5xx, throttling, network blips during
        // workdir/output transfers. Independent of process-level retries.
        maxErrorRetry = 10
        uploadChunkSize = 100.MB
        uploadMaxAttempts = 10
        uploadRetrySleep = 10.s
        // maxConnections = 2    // tightly coupled to uploadMaxThreads — large deltas caused issues
        // uploadMaxThreads = 2  // tune per uploader
    }

    batch {
        // Miniconda-installed awscli; LaunchTemplate user-data puts it here.
        // NF mounts the grandparent dir (/opt/conda-aws) into the container —
        // install must be self-contained under that tree.
        cliPath = '/opt/conda-aws/bin/aws'
        jobRole = 'arn:aws:iam::730883236839:role/nf-reads-profiler-batch-job-role'
        // Batch-level retry on spot reclaim ("Host EC2 terminated"). Bypasses Nextflow's
        // process.maxRetries path (which doesn't catch host termination). See issue I19.
        maxSpotAttempts = 5
        maxTransferAttempts = 100
        delayBetweenAttempts = 10.s
        maxParallelTransfers = 10
        // Bind the local EBS path to the container. See infra/batch-stack.yaml UserData section
        volumes = ['/mnt/dbs:/mnt/dbs']
    }
}

// ---------------------------------------------------------------------------
// Execution reports — redeclared here so they pick up this file's S3 `outdir`
// (and the run's `project`) instead of nextflow.config's frozen defaults.
// Nextflow interpolates these GStrings at PARSE TIME, so for the project to
// resolve, the run config MUST set `params { project = ... }` BEFORE
// `includeConfig conf/aws_batch.config`. If project is set after the include
// it freezes to 'none' and reports land under <outdir>/none/reports/.
// ---------------------------------------------------------------------------
timeline {
  enabled = false
  overwrite = true
  file = "${params.outdir}/${params.project}/reports/${params.ts}_timeline.html"
}

report {
  enabled = true
  overwrite = true
  file = "${params.outdir}/${params.project}/reports/${params.ts}_report.html"
}

dag {
  enabled = false
  overwrite = true
  file = "${params.outdir}/${params.project}/reports/${params.ts}_dag.html"
}

trace {
  enabled = true
  overwrite = true
  file = "${params.outdir}/${params.project}/reports/${params.ts}_trace.txt"
}
